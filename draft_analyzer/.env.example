# Copy this file to .env and fill in your values.
# See README.md for exactly how to find each of these.

# The numeric ID in your league's ESPN URL, e.g. ...leagueId=123456 -> 123456
ESPN_LEAGUE_ID=

# The NFL season year the draft is for
ESPN_SEASON=2026

# Your team's numeric ID within the league (README explains how to find it)
MY_TEAM_ID=

# Required for PRIVATE leagues -- two cookies from your browser after logging
# into fantasy.espn.com. Leave blank only if your league is public.
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}

# How often (seconds) to poll ESPN for new picks during the draft
POLL_SECONDS=4

# How many players to pull into the rankable pool (increase for very deep/keeper leagues)
DRAFT_POOL_SIZE=500

# Local port for the dashboard
PORT=5050
